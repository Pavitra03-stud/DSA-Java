class Student {

    private String name;
    private int rollNumber;
    private int[] marks;

    Student(String name, int rollNumber, int[] marks) {
        this.name = name;
        this.rollNumber = rollNumber;
        this.marks = marks;
    }

    int total() {
        int sum = 0;

        for (int i = 0; i < 5; i++) {
            sum += marks[i];
        }

        return sum;
    }

    double average() {
        return total() / 5.0;
    }

    char grade() {
        double avg = average();

        if (avg >= 90)
            return 'A';
        else if (avg >= 80)
            return 'B';
        else if (avg >= 70)
            return 'C';
        else if (avg >= 60)
            return 'D';
        else
            return 'F';
    }

    void display() {
        System.out.println("Name: " + name);
        System.out.println("Roll Number: " + rollNumber);
        System.out.println("Total: " + total());
        System.out.println("Average: " + average());
        System.out.println("Grade: " + grade());
    }
}

public class Main {
    public static void main(String[] args) {

        Student s1 = new Student(
            "Pavitra",
            101,
            new int[]{90, 85, 88, 92, 95}
        );

        Student s2 = new Student(
            "Ravi",
            102,
            new int[]{75, 80, 70, 78, 82}
        );

        Student s3 = new Student(
            "Kavin",
            103,
            new int[]{60, 65, 70, 55, 68}
        );

        s1.display();
        s2.display();
        s3.display();
    }
}